# ===========================================
# VIDEO PLATFORM ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ----- SUPABASE -----
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- BUNNY.NET -----
# Get these from: Bunny.net Dashboard > Account Settings
BUNNY_API_KEY=your-bunny-api-key-here
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_CDN_URL=https://your-pullzone.b-cdn.net

# ----- APP SETTINGS -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
